# Copy to .env and adjust. Every value has a safe default, so the system runs
# with no configuration at all (mock LLM backend, local embeddings).

# Which LLM backend: mock | ollama | openai
LLM_PROVIDER=mock

# Ollama (local model on the remote server). When tunnelling over SSH use
# http://localhost:11434 with: ssh -N -L 11434:localhost:11434 zorin
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# OpenAI (used only for the final verification run)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Dense retrieval embedding model (downloaded locally on first use)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval and agent tuning
TOP_K=5
RRF_K=60
MAX_STEPS=8
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Multi-agent: when 1/true, the agent gains an "ask_specialist" tool backed by a
# focused retrieval sub-agent it can delegate sub-questions to. Default off.
ENABLE_SPECIALIST=0
